# 飞书应用凭证（在 https://open.feishu.cn/app 创建应用后获取）
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Claude 默认配置
DEFAULT_MODEL=claude-sonnet-4-6
DEFAULT_CWD=~

# 工具权限模式：bypassPermissions（跳过所有确认，推荐个人使用）
#              default（需要确认敏感操作）
PERMISSION_MODE=bypassPermissions

# （可选）Claude CLI 路径，留空则自动从 PATH 查找
# macOS/Linux 示例： CLAUDE_CLI_PATH=/usr/local/bin/claude
# Windows 关键：显式指向原生 exe，避免 asyncio 无法执行 claude.CMD
# CLAUDE_CLI_PATH=C:/Users/你的用户名/.local/bin/claude.exe

# （可选）卡片按钮回调用的 ngrok 固定域名，配了之后重启公网地址不变
# 仅「卡片按钮」回调需要；悬浮菜单走长连接不需要 ngrok
# NGROK_DOMAIN=your-fixed-domain.ngrok-free.dev
